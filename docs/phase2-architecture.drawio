        <mxCell id="p4-31" value="0 dòng (status đã đổi)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p4-layer">
