  <diagram id="p5" name="5. UoW + Retry + Circuit Breaker ④⑥">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="p5-root" />
        <mxCell id="p5-layer" parent="p5-root" />
        <mxCell id="p5-1" value="&lt;b style='font-size:22px'&gt;④ Retry + Circuit Breaker và ⑥ Unit of Work&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555'&gt;Phụ trách: Hiếu. Thử lại cả Unit of Work chứ không thử lại từng câu SQL.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="p5-layer">
          <mxGeometry x="20" y="10" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-2" value="Vy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p5-layer">
          <mxGeometry x="1240" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-3" value="Hiếu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p5-layer">
          <mxGeometry x="1385" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-4" value="Thuý" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p5-layer">
          <mxGeometry x="1530" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-5" value="Giữ từ Phase 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="p5-layer">
          <mxGeometry x="1240" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-6" value="Bên ngoài" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p5-layer">
          <mxGeometry x="1385" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-7" value="&lt;b&gt;Use case&lt;/b&gt;&lt;br&gt;OrderProcessor&lt;br&gt;CancelOrderService&lt;br&gt;PaymentWebhookHandler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p5-layer">
          <mxGeometry x="40" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-8" value="&lt;b&gt;④ RetryPolicy&lt;/b&gt;&lt;br&gt;3 lần · 100/200/400 ms&lt;br&gt;+ jitter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p5-layer">
          <mxGeometry x="300" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-9" value="&lt;b&gt;④ CircuitBreaker&lt;/b&gt;&lt;br&gt;OPEN → fail fast" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p5-layer">
          <mxGeometry x="560" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-10" value="&lt;b&gt;⑥ UnitOfWork&lt;/b&gt;&lt;br&gt;BEGIN · COMMIT&lt;br&gt;ROLLBACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p5-layer">
          <mxGeometry x="820" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-11" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;dùng chung session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p5-layer">
          <mxGeometry x="1080" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-12" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p5-layer">
          <mxGeometry x="1340" y="150" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-13" value="gọi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-7" target="p5-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-14" value="lần thử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-8" target="p5-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-15" value="nếu CLOSED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-9" target="p5-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-16" value="uow.orders / uow.ticket_types" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-10" target="p5-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-17" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-11" target="p5-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-18" value="&lt;b&gt;Thử lại khi&lt;/b&gt;: OperationalError, mất kết nối, deadlock, serialization failure, pool timeout.&lt;br&gt;&lt;b&gt;Không thử lại&lt;/b&gt;: lỗi nghiệp vụ (SoldOut, InvalidState, Forbidden, NotFound).&lt;br&gt;Retry an toàn vì mỗi lệnh có Idempotency-Key ⑤ và mọi thay đổi trạng thái là UPDATE có điều kiện ②." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="p5-layer">
          <mxGeometry x="40" y="280" width="1450" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5-19" value="CLOSED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p5-layer">
          <mxGeometry x="80" y="470" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-20" value="OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p5-layer">
          <mxGeometry x="480" y="470" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-21" value="HALF_OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p5-layer">
          <mxGeometry x="280" y="640" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-22" value="5 lỗi trong 10 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-19" target="p5-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-23" value="sau 15 s" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-20" target="p5-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-24" value="1 request thử thành công" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p5-layer" source="p5-21" target="p5-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-25" value="thử thất bại" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="p5-layer" source="p5-21" target="p5-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-26" value="&lt;b&gt;Circuit Breaker&lt;/b&gt;&lt;br&gt;Khi OPEN, request bị từ chối ngay với 503 + Retry-After thay vì giữ luồng và kết nối 30 giây như Phase 1. Mỗi đích có breaker riêng: một cho PostgreSQL, một cho cổng thanh toán." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="p5-layer">
          <mxGeometry x="40" y="400" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5-27" value="&lt;b&gt;⑥ Unit of Work trong service&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:Consolas'&gt;with uow:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if not uow.ticket_types.reserve(tt_id, q):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;raise SoldOut()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;order = uow.orders.add(PENDING_PAYMENT)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uow.idempotency.complete(key, order)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uow.commit()&amp;nbsp;&amp;nbsp;# lỗi ở bất kỳ bước nào → rollback toàn bộ&lt;/span&gt;&lt;br&gt;&lt;br&gt;Tầng API không còn tự commit trong get_db(); service quyết định ranh giới transaction và cùng một UoW chạy được cả trong API lẫn Worker." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="p5-layer">
          <mxGeometry x="760" y="400" width="730" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>