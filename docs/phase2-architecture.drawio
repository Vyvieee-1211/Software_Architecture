        <mxCell id="p4-21" value="&lt;b&gt;Chuyển trạng thái an toàn khi đồng thời&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:Consolas'&gt;UPDATE orders&lt;br&gt;&amp;nbsp;&amp;nbsp;SET status = 'CANCELLED', version = version + 1&lt;br&gt;&amp;nbsp;WHERE id = :id AND status = :expected AND version = :v;&lt;/span&gt;&lt;br&gt;&lt;br&gt;rowcount = 1 → request này thắng: nhả vé / hoàn tiền / ghi history trong cùng UoW ⑥&lt;br&gt;rowcount = 0 → đơn đã đổi trạng thái: trả 409 InvalidState, &lt;b&gt;không&lt;/b&gt; nhả vé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="p4-layer">
          <mxGeometry x="40" y="540" width="880" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p4-22" value="&lt;b&gt;Request A&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p4-layer">
          <mxGeometry x="1000" y="150" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-23" value="" style="endArrow=none;dashed=1;strokeColor=#999999;html=1;" edge="1" parent="p4-layer">
