            <mxPoint x="1060" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4-24" value="&lt;b&gt;Request B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p4-layer">
          <mxGeometry x="1160" y="150" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-25" value="" style="endArrow=none;dashed=1;strokeColor=#999999;html=1;" edge="1" parent="p4-layer">
