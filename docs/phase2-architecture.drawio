          </mxGeometry>
        </mxCell>
        <mxCell id="p4-29" value="UPDATE … status=PAID, v=3 (chờ khoá dòng)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p4-layer">
          <mxGeometry relative="1" as="geometry">
