        <mxCell id="p2-20" value="" style="endArrow=none;dashed=1;strokeColor=#999999;html=1;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1290" y="130" as="sourcePoint" />
            <mxPoint x="1290" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-21" value="POST /orders {ticket_type_id, quantity}&lt;br&gt;Idempotency-Key: k1" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="160" as="sourcePoint" />
            <mxPoint x="290" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-22" value="⑤ tìm idempotency_keys (user, k1); chưa có → INSERT IN_PROGRESS" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="205" as="sourcePoint" />
            <mxPoint x="890" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-23" value="③ LPUSH orders:{tt} PlaceOrderCommand" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="250" as="sourcePoint" />
            <mxPoint x="490" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-24" value="202 Accepted {request_id}" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="290" as="sourcePoint" />
            <mxPoint x="90" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-25" value="③ BRPOP (tuần tự theo ticket_type)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="335" as="sourcePoint" />
            <mxPoint x="690" y="335" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-26" value="⑥ BEGIN · UPDATE ticket_types SET remaining = remaining − q WHERE id = ? AND remaining ≥ q" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="380" as="sourcePoint" />
            <mxPoint x="890" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-27" value="INSERT orders (PENDING_PAYMENT, hold_expires_at = now + 10')" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="420" as="sourcePoint" />
            <mxPoint x="890" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-28" value="idempotency_keys → COMPLETED + response · COMMIT" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="460" as="sourcePoint" />
            <mxPoint x="890" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-29" value="SET order_req:{id} = order_id | SOLD_OUT" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="500" as="sourcePoint" />
            <mxPoint x="490" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-30" value="GET /order-requests/{id} (polling)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="620" as="sourcePoint" />
            <mxPoint x="290" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-31" value="GET order_req:{id}" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="655" as="sourcePoint" />
            <mxPoint x="490" y="655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-32" value="200 {order_id, status: PENDING_PAYMENT}" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="690" as="sourcePoint" />
            <mxPoint x="90" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-33" value="POST /orders/{id}/payments" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="735" as="sourcePoint" />
            <mxPoint x="290" y="735" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-34" value="⑦ INSERT payments (INITIATED)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="770" as="sourcePoint" />
            <mxPoint x="890" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-35" value="⑦ tạo giao dịch (④ Circuit Breaker)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="805" as="sourcePoint" />
            <mxPoint x="1090" y="805" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-36" value="payment_url → chuyển hướng" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="840" as="sourcePoint" />
            <mxPoint x="90" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-37" value="⑦ webhook / IPN (ký HMAC, provider_txn_id)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="885" as="sourcePoint" />
            <mxPoint x="290" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-38" value="⑥ BEGIN · payments SUCCEEDED · orders PENDING_PAYMENT → PAID (có điều kiện) · INSERT ledger_entries CHARGE · COMMIT" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="930" as="sourcePoint" />
            <mxPoint x="890" y="930" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-39" value="200 OK (webhook lặp lại → bỏ qua nhờ UNIQUE provider_txn_id)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="970" as="sourcePoint" />
            <mxPoint x="1090" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-40" value="UPDATE orders SET EXPIRED WHERE status = PENDING_PAYMENT AND hold_expires_at &amp;lt; now · cộng lại remaining" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1290" y="1060" as="sourcePoint" />
            <mxPoint x="890" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-41" value="&lt;b&gt;alt&lt;/b&gt; &amp;nbsp;rowcount = 0 → ROLLBACK, order_req = SOLD_OUT (409)&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;lỗi DB tạm thời → ④ Retry 3 lần (backoff); lỗi liên tục → Circuit Breaker mở, trả 503" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff7ed;strokeColor=#c2410c;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="200" y="520" width="1000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-42" value="&lt;b&gt;alt&lt;/b&gt; &amp;nbsp;không thanh toán trong 10 phút → Hold Expiry Job nhả vé trong cùng một transaction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff7ed;strokeColor=#c2410c;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="200" y="995" width="1200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
