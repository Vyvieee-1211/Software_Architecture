          </mxGeometry>
        </mxCell>
        <mxCell id="p4-30" value="1 dòng → nhả vé, COMMIT" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="p4-layer">
