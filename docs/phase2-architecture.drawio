        <mxCell id="p4-33" value="Kết quả: tồn kho chỉ được cộng lại một lần, sửa lỗi NFR05." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p4-layer">
