<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="p1" name="1. Tổng quan Phase 2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p1-root" />
        <mxCell id="p1-layer" parent="p1-root" />
        <mxCell id="p1-1" value="&lt;b style='font-size:22px'&gt;Concert Ticketing — Kiến trúc Phase 2&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555'&gt;Các số ①–⑦ ứng với bảng phân công ở cuối trang. Màu = người phụ trách.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="p1-layer">
          <mxGeometry x="20" y="10" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-2" value="Vy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p1-layer">
          <mxGeometry x="1240" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1-3" value="Hiếu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-layer">
          <mxGeometry x="1385" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1-4" value="Thuý" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p1-layer">
          <mxGeometry x="1530" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1-5" value="Giữ từ Phase 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="p1-layer">
          <mxGeometry x="1240" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1-6" value="Bên ngoài" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p1-layer">
          <mxGeometry x="1385" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1-7" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;frontend/ (HTML/JS)&lt;br&gt;gửi kèm Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-layer">
          <mxGeometry x="20" y="330" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-8" value="&lt;b&gt;Locust&lt;/b&gt;&lt;br&gt;kiểm thử tải" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1-layer">
          <mxGeometry x="20" y="190" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-9" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;Load balancer&lt;br&gt;TLS · rate limit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="p1-layer">
          <mxGeometry x="240" y="330" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-10" value="API Service × N &amp;nbsp;(FastAPI · stateless · JWT)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;fillColor=#fafafa;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#fafafa;" vertex="1" parent="p1-layer">
          <mxGeometry x="440" y="140" width="420" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p1-11" value="&lt;b&gt;Routers&lt;/b&gt;: /auth · /concerts · /orders · /order-requests · /payments · /webhooks/payment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="45" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-12" value="&lt;b&gt;⑤ Idempotency Middleware&lt;/b&gt;&lt;br&gt;trùng Idempotency-Key → trả lại kết quả cũ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="100" width="185" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-13" value="&lt;b&gt;④ Error handler&lt;/b&gt;&lt;br&gt;lỗi DB tạm thời → 503 + Retry-After" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="215" y="100" width="185" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-14" value="&lt;b&gt;③ OrderService.place()&lt;/b&gt;&lt;br&gt;kiểm tra → đẩy PlaceOrderCommand → 202" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="175" width="185" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1-15" value="&lt;b&gt;② CancelOrderService&lt;/b&gt;&lt;br&gt;OrderStateMachine + UPDATE có điều kiện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="215" y="175" width="185" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1-16" value="&lt;b&gt;⑦ PaymentService&lt;/b&gt;&lt;br&gt;tạo giao dịch · hoàn tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="255" width="185" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1-17" value="&lt;b&gt;⑦ PaymentWebhookHandler&lt;/b&gt;&lt;br&gt;xác minh chữ ký · ghi ledger" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="215" y="255" width="185" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1-18" value="&lt;b&gt;⑥ Unit of Work&lt;/b&gt; — service tự mở / commit / rollback transaction; các repository dùng chung một session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="335" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1-19" value="&lt;b&gt;① Repositories&lt;/b&gt;: user · concert · ticket_type · order · payment · ledger · idempotency" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="405" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1-20" value="&lt;b&gt;④ Retry (backoff + jitter) + Circuit Breaker&lt;/b&gt;&lt;br&gt;bọc mọi lời gọi tới PostgreSQL và cổng thanh toán" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p1-10">
          <mxGeometry x="20" y="475" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-21" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;③ Queue: orders:{ticket_type_id}&lt;br&gt;③ Trạng thái yêu cầu: order_req:{id}&lt;br&gt;Cache danh sách concert (TTL 30s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-layer">
          <mxGeometry x="920" y="140" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1-22" value="&lt;b&gt;③ Order Worker × M&lt;/b&gt;&lt;br&gt;mỗi ticket_type do 1 worker xử lý tuần tự&lt;br&gt;⑥ UoW: trừ vé + tạo đơn PENDING_PAYMENT&lt;br&gt;④ Retry + Circuit Breaker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-layer">
          <mxGeometry x="920" y="320" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-23" value="&lt;b&gt;⑦ Hold Expiry Job&lt;/b&gt; (mỗi 30s)&lt;br&gt;PENDING_PAYMENT quá 10 phút → EXPIRED, nhả vé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p1-layer">
          <mxGeometry x="920" y="510" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-24" value="&lt;b&gt;① PostgreSQL&lt;/b&gt;&lt;br&gt;khoá theo dòng (row-level lock)&lt;br&gt;&lt;br&gt;users · concerts · ticket_types&lt;br&gt;orders (+version) · payments&lt;br&gt;ledger_entries · idempotency_keys&lt;br&gt;order_status_history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p1-layer">
          <mxGeometry x="1270" y="250" width="240" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p1-25" value="&lt;b&gt;Cổng thanh toán&lt;/b&gt;&lt;br&gt;VNPay / MoMo (sandbox)&lt;br&gt;&lt;i&gt;hệ thống bên ngoài&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-layer">
          <mxGeometry x="1270" y="580" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-26" value="HTTPS · JWT&lt;br&gt;Idempotency-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p1-layer" source="p1-7" target="p1-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-27" value="tải" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p1-layer" source="p1-8" target="p1-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="315" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-28" value="chia đều" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p1-layer" source="p1-9" target="p1-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-29" value="③ LPUSH command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="p1-layer" source="p1-14" target="p1-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-30" value="cache · trạng thái yêu cầu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;entryX=0;entryY=0.3;" edge="1" parent="p1-layer" source="p1-11" target="p1-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-31" value="③ BRPOP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p1-layer" source="p1-21" target="p1-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-32" value="⑥ 1 transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="p1-layer" source="p1-22" target="p1-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-33" value="SQL qua UoW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="p1-layer" source="p1-20" target="p1-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-34" value="UPDATE … EXPIRED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;entryX=0.3;entryY=1;" edge="1" parent="p1-layer" source="p1-23" target="p1-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-35" value="⑦ tạo giao dịch (④ Circuit Breaker)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.7;" edge="1" parent="p1-layer" source="p1-16" target="p1-25">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="552" y="730" />
              <mxPoint x="1240" y="730" />
              <mxPoint x="1240" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-36" value="⑦ webhook / IPN (ký HMAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="p1-layer" source="p1-25" target="p1-17">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1230" y="610" />
              <mxPoint x="1230" y="640" />
              <mxPoint x="890" y="640" />
              <mxPoint x="890" y="427" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-37" value="chuyển hướng sang trang thanh toán" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="p1-layer" source="p1-7" target="p1-25">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="105" y="770" />
              <mxPoint x="1390" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-38" value="&lt;table style='border-collapse:collapse;width:100%;font-size:12px' border='1' cellpadding='5'&gt;&#10;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Vấn đề Phase 1&lt;/th&gt;&lt;th&gt;Giải pháp / pattern&lt;/th&gt;&lt;th&gt;Nằm ở&lt;/th&gt;&lt;th&gt;Phụ trách&lt;/th&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;①&lt;/td&gt;&lt;td&gt;SQLite khoá cả file khi ghi&lt;/td&gt;&lt;td&gt;Đổi sang PostgreSQL, thiết kế lại bảng (orders.version, payments, ledger_entries, idempotency_keys)&lt;/td&gt;&lt;td&gt;PostgreSQL · Repositories&lt;/td&gt;&lt;td&gt;Vy&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;②&lt;/td&gt;&lt;td&gt;Huỷ 1 đơn 2 lần đồng thời → hoàn vé 2 lần&lt;/td&gt;&lt;td&gt;Optimistic Concurrency (UPDATE … WHERE status AND version) + State pattern&lt;/td&gt;&lt;td&gt;CancelOrderService&lt;/td&gt;&lt;td&gt;Hiếu&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;③&lt;/td&gt;&lt;td&gt;100 người đặt cùng lúc → timeout&lt;/td&gt;&lt;td&gt;Queue-Based Load Leveling + Command (PlaceOrderCommand), trả 202 rồi polling&lt;/td&gt;&lt;td&gt;Redis · Order Worker&lt;/td&gt;&lt;td&gt;Thuý&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;④&lt;/td&gt;&lt;td&gt;Lỗi DB treo / HTTP 500&lt;/td&gt;&lt;td&gt;Retry (backoff + jitter) + Circuit Breaker, fail fast 503&lt;/td&gt;&lt;td&gt;Resilience · Error handler&lt;/td&gt;&lt;td&gt;Hiếu&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;⑤&lt;/td&gt;&lt;td&gt;Timeout → thử lại tạo đơn trùng&lt;/td&gt;&lt;td&gt;Idempotency Key (bảng idempotency_keys, UNIQUE(user_id, key))&lt;/td&gt;&lt;td&gt;Idempotency Middleware&lt;/td&gt;&lt;td&gt;Thuý&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;⑥&lt;/td&gt;&lt;td&gt;Ranh giới transaction nằm ở tầng API&lt;/td&gt;&lt;td&gt;Unit of Work&lt;/td&gt;&lt;td&gt;Service · Worker&lt;/td&gt;&lt;td&gt;Hiếu&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;⑦&lt;/td&gt;&lt;td&gt;Chưa có thanh toán, chưa có log dòng tiền&lt;/td&gt;&lt;td&gt;PaymentService + webhook + ledger_entries chỉ ghi thêm (append-only), giữ vé 10 phút&lt;/td&gt;&lt;td&gt;Payment · Hold Expiry Job&lt;/td&gt;&lt;td&gt;Vy&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="p1-layer">
          <mxGeometry x="20" y="800" width="1490" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2. Luồng đặt vé &amp; thanh toán">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p2-root" />
        <mxCell id="p2-layer" parent="p2-root" />
        <mxCell id="p2-1" value="&lt;b style='font-size:22px'&gt;Luồng đặt vé và thanh toán&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555'&gt;Từ lúc bấm đặt đến lúc đơn được thanh toán hoặc hết hạn. Mũi tên nét đứt = phản hồi.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="p2-layer">
          <mxGeometry x="20" y="10" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-2" value="Vy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="1240" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-3" value="Hiếu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="1385" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-4" value="Thuý" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="1530" y="14" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-5" value="Giữ từ Phase 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="1240" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-6" value="Bên ngoài" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p2-layer">
          <mxGeometry x="1385" y="44" width="135" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-7" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p2-layer">
          <mxGeometry x="15" y="80" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-8" value="" style="endArrow=none;dashed=1;strokeColor=#999999;html=1;" edge="1" parent="p2-layer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="130" as="sourcePoint" />
            <mxPoint x="90" y="1100" as="targetPoint" />
