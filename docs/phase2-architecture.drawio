        </mxCell>
        <mxCell id="p2-19" value="&lt;b&gt;Hold Expiry Job&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p2-layer">
          <mxGeometry x="1215" y="80" width="150" height="50" as="geometry" />
