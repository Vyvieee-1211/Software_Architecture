# PostgreSQL (docker compose up db). SQLite vẫn chạy được cho dev/test: sqlite:///./concert.db
DATABASE_URL=postgresql+psycopg://concert:concert@localhost:5432/concert
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-or-more
JWT_EXPIRE_MINUTES=60
ADMIN_EMAILS=demo@example.com

# Cache danh sách concert/hạng vé (giây); số vé còn lại hiển thị cũ tối đa chừng này. 0 = tắt
CATALOG_CACHE_TTL_SECONDS=2

# Giữ chỗ / thanh toán
HOLD_MINUTES=12
MAX_TICKETS_PER_ORDER=10
MAX_HELD_TICKETS_PER_USER=10
HOLD_SWEEP_INTERVAL_SECONDS=5
# Hàng đợi yêu cầu đặt vé: số luồng worker mỗi tiến trình (0 = tắt), chu kỳ hỏi khi rỗng (giây),
# số lần lỗi bất ngờ trước khi loại yêu cầu, giá trị header Retry-After (giây)
ORDER_WORKERS=2
ORDER_WORKER_POLL_SECONDS=0.5
ORDER_REQUEST_MAX_ATTEMPTS=3
ORDER_STATUS_RETRY_AFTER_SECONDS=1
# Đơn đã thanh toán chỉ hủy (hoàn tiền) được trước giờ diễn ít nhất chừng này giờ
REFUND_CUTOFF_HOURS=24

# Đợt mở bán: Waiting room → Rate limit → Load shedding
# Waiting room bật trong chừng này phút đầu sau giờ mở bán (0 = tắt), vào hàng sớm trước chừng này phút
WAITING_ROOM_MINUTES=30
WAITING_ROOM_LEAD_MINUTES=15
# Lúc mở bán cho vào ngay N người, sau đó thêm M người mỗi phút; thẻ vào cửa dùng được chừng này phút
WAITING_ROOM_INITIAL_BATCH=100
WAITING_ROOM_ADMIT_PER_MINUTE=100
WAITING_ROOM_PASS_MINUTES=10
WAITING_ROOM_SECRET=dev-waiting-room-secret-change-me-32-bytes
# Số request mỗi phút (0 = tắt): đăng nhập/đăng ký theo IP, còn lại theo user
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ORDERS_PER_MINUTE=10
RATE_LIMIT_ORDER_STATUS_PER_MINUTE=120
RATE_LIMIT_WAITING_ROOM_PER_MINUTE=60
# Số request đang xử lý tối đa mỗi tiến trình, vượt thì trả 503 ngay (0 = tắt)
MAX_IN_FLIGHT_REQUESTS=200
OVERLOAD_RETRY_AFTER_SECONDS=1
# Cổng thanh toán: mock (giả lập) | vnpay. Bật nhiều cổng bằng dấu phẩy, vd. "vnpay,mock":
# khách chọn cổng khi thanh toán, cổng đầu tiên là mặc định.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-secret-change-me
# Cổng thật đưa khách về {PUBLIC_BASE_URL}/payments/return/{cổng} rồi chuyển tiếp tới địa chỉ này
PAYMENT_RETURN_URL=http://localhost:8000/#/orders
PAYMENT_GATEWAY_TIMEOUT_SECONDS=10
# VNPay sandbox (https://sandbox.vnpayment.vn): khai IPN URL = {PUBLIC_BASE_URL}/payments/webhook
# trong trang quản trị merchant. Chạy trên localhost vẫn được: khi khách quay về
# /payments/return/vnpay, kết quả đã ký được kiểm tra và chốt đơn ngay. IPN (cần PUBLIC_BASE_URL
# công khai, vd. ngrok) chỉ cần khi khách đóng tab trước lúc quay về.
#VNPAY_TMN_CODE=
#VNPAY_HASH_SECRET=
#VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
TICKET_QR_SECRET=dev-ticket-qr-secret-change-me
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL: chờ khóa dòng / thời gian chạy một câu lệnh (ms); 0 = không giới hạn
DB_PG_LOCK_TIMEOUT_MS=3000
DB_PG_STATEMENT_TIMEOUT_MS=15000

# Connection pool wait (seconds); SQLite file DB uses QueuePool.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=2
# SQLite lock wait per operation; this is not a general query/HTTP timeout.
DB_SQLITE_BUSY_TIMEOUT_SECONDS=1
# Total attempts including the first; only known-safe failures are replayed.
DB_MAX_ATTEMPTS=3
DB_RETRY_BASE_SECONDS=0.05
DB_RETRY_MAX_SECONDS=0.5
# Exhausted operations counted in a sliding window, per worker process.
DB_BREAKER_FAILURE_THRESHOLD=5
DB_BREAKER_WINDOW_SECONDS=30
DB_BREAKER_RECOVERY_SECONDS=10
