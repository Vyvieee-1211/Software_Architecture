# PostgreSQL (docker compose up db). SQLite vẫn chạy được cho dev/test: sqlite:///./concert.db
DATABASE_URL=postgresql+psycopg://concert:concert@localhost:5432/concert
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-or-more
JWT_EXPIRE_MINUTES=60
ADMIN_EMAILS=demo@example.com

# Giữ chỗ / thanh toán
HOLD_MINUTES=12
MAX_TICKETS_PER_ORDER=10
MAX_HELD_TICKETS_PER_USER=10
HOLD_SWEEP_INTERVAL_SECONDS=5
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-secret-change-me
TICKET_QR_SECRET=dev-ticket-qr-secret-change-me
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL: chờ khóa dòng / thời gian chạy một câu lệnh (ms); 0 = không giới hạn
DB_PG_LOCK_TIMEOUT_MS=3000
DB_PG_STATEMENT_TIMEOUT_MS=15000

# Connection pool wait (seconds); SQLite file DB uses QueuePool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=2
# SQLite lock wait per operation; this is not a general query/HTTP timeout.
DB_SQLITE_BUSY_TIMEOUT_SECONDS=1
# Total attempts including the first; only known-safe failures are replayed.
DB_MAX_ATTEMPTS=3
DB_RETRY_BASE_SECONDS=0.05
DB_RETRY_MAX_SECONDS=0.5
# Exhausted operations counted in a sliding window, per worker process.
DB_BREAKER_FAILURE_THRESHOLD=5
DB_BREAKER_WINDOW_SECONDS=30
DB_BREAKER_RECOVERY_SECONDS=10
